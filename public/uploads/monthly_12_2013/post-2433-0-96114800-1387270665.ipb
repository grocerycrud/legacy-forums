    <!--  Gestion de l'affichage de l'extendedmenu -->
	<script type="text/javascript">
	$('#bandeau_extendedmenu').show(); $('#bandeau_accessmenu').addClass('bandeau_accessmenu_actif');	$('#bouton_menu').click(function() {
		 open_caption = 'Open menu';
		 close_caption = 'Close menu';
		//Ajax call, action open / close menu is recorded in session
		//console.log('Menu cliqué');
		$.get('http://localhost/osu/events/open_menu', function(data) {
			//console.log('Appel ajax du controleur events::open_menu');
			//console.log('Retour: '+data);
			});
		//Managing the animation of the menu
		if ($("#bandeau_extendedmenu").is(":hidden")) {
				$('#bouton_menu').html(close_caption).effect('pulsate',{ times:1 }, 500);
				$('#bandeau_accessmenu').addClass('bandeau_accessmenu_actif');
				$('#bandeau_extendedmenu').slideDown('slow');
			} else {
				$('#bouton_menu').html(open_caption).effect('pulsate',{ times:1 }, 500);
				$('#bandeau_accessmenu').removeClass('bandeau_accessmenu_actif');
				$("#bandeau_extendedmenu").slideUp('slow');
			}
			});
	</script>
