<!--  Scripts statiques a charger une fois la page construite -->
	<script type="text/javascript">
	//<![CDATA[
	$(document).ready(function() {
		//Adds the width of the # content div if the menu on the right does not exist
		if ($("#navigation").length == 0){ //If the item navigation does not exist
			//$('#content').css('width', '975px'); //We sets the width of div # content of 975 pixels
			$('#content').addClass('content_fullwidth'); //We sets the width of div # content of 975 pixels
		}
		if ($("#slideshow").length > 0){ //if #slideshow exists
			//Cycle + Load sequentially pictures
			$('#slideshow').cycle({ 
			    delay: -3000, 
			    timeout: 5000, 
			    fx: 'fade', 
			    prev: '#prev', 
			    next: '#next', 
			    pause: true, 
			    pauseOnPagerHover: true,
			    before: function(){
			    	$('.slideshow_pause').hide();
			    },
			    after: function(currSlideElement, nextSlideElement) {
			        // Retrieves the next id of the next li
			        var next = $(nextSlideElement).next();
			        //retrieves the id #slide-x span element
			        next = $('#' + next.attr('id') + ' span.slideshow_image');
			        // If the picture has not been loaded
			        if (next.find('img').length == 0) {
			            // We create the img element and insert it in the li
			            var img = $('<img alt="" />').attr('src', next.attr('title'));
			            next.append( img );
			        }
			    }
			});
			//Pause button management
			$("span.slideshow_image").hover(
				function () {
					$('.slideshow_pause').fadeIn('fast');
				}, 
				function () {
					$('.slideshow_pause').fadeOut('fast');
				}
			);
			//Fix tooltip
			$("span.slideshow_image").hover(function(){
		        $(this).stop().attr('title', '');},
		        function(){$(this).stop().attr();
		     });
		}
		//ToTop
		$().UItoTop({ easingType: 'easeOutQuart' });
		
    });
	//]]>
	</script>
