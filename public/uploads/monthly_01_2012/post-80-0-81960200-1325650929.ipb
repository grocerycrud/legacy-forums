+	protected function get_relation_display($field_info,$value)
+	{
+		if (empty($value)) {
+			return '';
+		}
+		$options_array = $this->get_relation_array($field_info->extras);
+		foreach($options_array as $option_value => $option)
+		{
+			if ($value == $option_value) {
+				return $option;
+			}
+		}
+		
+		return "Unknown - $value";
+	}
 	
