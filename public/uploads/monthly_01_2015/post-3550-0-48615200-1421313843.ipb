<?php  if ( ! defined('BASEPATH')) exit('No direct script access allowed');
session_start(); //we need to call PHP's session object to access it through CI
 
class Main extends CI_Controller {

 
    function __construct()
    {
        parent::__construct();
 
        $this->load->library('grocery_CRUD');
		$this->load->database();
		$this->load->helper('url');
    }
 
    public function index()
    {
        echo "<h1>Faktury i korespondencje</h1>";//Just an example to ensure that we get into the function
		
	}
	
	
	public function fakturyp()
    {	
	
	
		// wyłączenie opcji usuwania rekordów
		$crud = new grocery_CRUD();
		$crud->set_table('fakturyp');
		//$crud->set_theme('datatables');
		//relacje
		$crud->set_relation('Nazwa_firmy','firma','Nazwa_firmy_klienta');
		
		$crud->unset_delete();
		$output = $crud->render();
		$this->_example_output($output);
		
		
        // $this->grocery_crud->set_table('fakturyp');
		
        // $output = $this->grocery_crud->render();
 
        // $this->_example_output($output); 
    }
	
