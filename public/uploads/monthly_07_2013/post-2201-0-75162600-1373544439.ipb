<?php if ( ! defined('BASEPATH')) exit('No direct script access allowed');

class Main extends CI_Controller {
	
	public $data= array();
	
	function __construct()
	{
		parent::__construct();
		$this->load->helper('url');	
		$this->load->helper('form');
		$this->load->library('auth');
		$this->load->library('parser');
		$this->load->library('grocery_CRUD');
		$this->data['login'] =  $this->auth->read('username');
		
		if(!$this->auth->is_loggedin())
		{
			redirect('/login/', 'refresh');
		}
	}
		
	public function index()
	{
		$data['login'] =  $this->auth->read('username');
		$this->grocery_crud->set_theme('datatables');
		$this->grocery_crud->set_table('pets');
		$this->grocery_crud->set_relation('owner_id','clients','{firstname} {lastname}');
		$this->grocery_crud->columns('owner_id','sex','type','chip_number','nickname');
		$this->grocery_crud->set_subject('Zwierze');
		$this->grocery_crud->unset_export();
		$this->grocery_crud->unset_print();
		$this->grocery_crud->add_action('Więcej', '', current_url().'/more/','ui-icon-plus');
		
		$this->grocery_crud->set_relation('race_id','races', 'name');
		$this->grocery_crud->required_fields('owner_id','sex','type','chip_number','nickname', 'race_id', 'color', 'name', 'born');
		
		
		
		$this->grocery_crud->callback_add_field('dad_id',array($this,'add_field_callback_1'));
		$this->grocery_crud->callback_edit_field('dad_id',array($this,'add_field_callback_1'));
		$this->grocery_crud->callback_add_field('mom_id',array($this,'add_field_callback_2'));
		$this->grocery_crud->callback_edit_field('mom_id',array($this,'add_field_callback_2'));

		$this->grocery_crud->display_as('owner_id','Właściciel')
							->display_as('type','Rodzaj')
							->display_as('name','Nazwa zwierzaka')
							->display_as('chip_number','Nr. Chip')
							->display_as('nickname','Przydomek')
							->display_as('race_id','Rasa')
							->display_as('born','Urodzony dnia')
							->display_as('color','Maść')
							->display_as('dad_id','Ojciec')
							->display_as('mom_id','Mama')
							->display_as('sex','Płeć');
							
		$this->grocery_crud->field_type('sex','dropdown', array('m' => 'Mężczyzna', 'k' => 'Kobieta'))
							->field_type('type','dropdown', array('dog' => 'Pies', 'cat' => 'Kot'))
							->field_type('born', 'datetime');
		
		//$this->grocery_crud->callback_after_insert(array($this, 'update_info'));
		//$this->grocery_crud->callback_after_update(array($this, 'update_info'));
	

		$data['tabela'] = $this->grocery_crud->render();
		
		if(	$this->grocery_crud->getState() == 'add' || $this->grocery_crud->getState() == 'edit' ) {
			$this->grocery_crud->add_fields('dad_id');
			$this->grocery_crud->edit_fields('dad_id');
		}
		
		
		$this->load->view('main_view_header', (array)$data);
		$this->load->view('main_view_tabela', (array)$data);
		$this->load->view('main_view_footer');
	}
	
	function add_field_callback_1()
	{
		$output = array('0' => 'Wybierz wartość.');
		
		$query = $this->db->query("SELECT `id` , `name`, `chip_number` , `nickname` FROM `pets` WHERE sex='m'");
		foreach ($query->result_array() as $row)
		{
			$output += array ( $row['id'] => $row['name'].' - '.$row['nickname'].' - '.$row['chip_number'] );
		}	
				
		return form_dropdown('e1', $output, '0', 'id="e1"');
	}
	
	function add_field_callback_2()
	{
		$output = array('0' => 'Wybierz wartość.');
		
		$query = $this->db->query("SELECT `id` , `name`, `chip_number` , `nickname` FROM `pets` WHERE sex='k'");
		foreach ($query->result_array() as $row)
		{
			$output += array ( $row['id'] => $row['name'].' - '.$row['nickname'].' - '.$row['chip_number'] );
		}	
				
		return form_dropdown('e2', $output, '0', 'id="e2"');
	}
	
	function update_info($post_array,$primary_key)
	{
		//$query = $this->db->query("TRUNCATE TABLE pets");
		//print_r($post_array);
		//print_r($primary_key);
		
		$data = array(
						'dad_id' => $post_array['field-dad_id']
				);
		$this->db->where('id', $primary_key);
		$this->db->update('pets', $data);

		return true;
	}
 
	 
	
	public function more() {
		$this->load->model('Pets_model','pets');
		
		$tabela = 0;
		if($this->pets->is_female($this->uri->segment($this->uri->total_segments()))){
			$this->grocery_crud->set_theme('datatables');
			$this->grocery_crud->set_table('female_card');
			$this->grocery_crud->set_relation('pet_id','pets','id');
			$this->grocery_crud->columns('mating', 'childbirth', 'heat_date', 'childrens');
			$this->grocery_crud->set_subject('');
			$this->grocery_crud->unset_export();
			$this->grocery_crud->unset_print();
			//$this->grocery_crud->unset_add();
			//$this->grocery_crud->unset_operations();
			
			$this->grocery_crud->set_primary_key('pet_id','famale_card');
			
			$this->grocery_crud->display_as('mating','Data krycia')
								->display_as('childbirth','Data porodu')
								->display_as('heat_date','Data cieczki')
								->display_as('childrens','Liczba szczeniąt')
								->display_as('pet_id','Wybierz zwierze');
								
			$this->grocery_crud->set_relation('pet_id','pets', '{name} - {nickname} - {chip_number}');
			
			$idd = $this->uri->segment($this->uri->total_segments()-1);
			//if(	$this->grocery_crud->getState() == 'add' && !is_numeric($this->uri->segment($this->uri->total_segments()-1))) {
			//	redirect('main/more/add/'.$idd, 'refresh');
			//}
			
			$tabela = $this->grocery_crud->render();
		}
		
		$data = array('sex' => $this->pets->is_female($this->uri->segment($this->uri->total_segments())),
					  'tabela' => $tabela,
					  'more' => $this->pets->more_data($this->uri->segment($this->uri->total_segments())),
					  'login' => $this->data['login']);
		
		$this->load->view('main_view_header', (array)$data);
		$this->load->view('main_view_more', (array)$data);
		$this->load->view('main_view_footer');
	}

}
